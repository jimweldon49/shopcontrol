# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection
DATABASE_URL=postgresql://shopapp:CHANGE_ME@localhost:5432/concept_shop_control

# Port the API listens on
PORT=4000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# How long a login stays valid before an employee has to log in again
JWT_EXPIRES_IN=12h

# Comma-separated list of origins allowed to call this API.
# Set this to wherever you host the client (e.g. http://192.168.1.50:8080)
CORS_ORIGIN=*


# Public URL of the client app. Used inside password reset email links.
# Example: https://shop.yourdomain.com
PUBLIC_CLIENT_URL=http://localhost:8080

# Self-service password reset email settings
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=CHANGE_ME
SMTP_FROM="Concept Shop Control <your-email@example.com>"
PASSWORD_RESET_EXPIRES_MINUTES=30

# HTTPS certificate support for direct Node HTTPS
# Use either a real certificate or an internal/self-signed certificate.
# Recommended file names if storing under server/certs:
# SSL_KEY_PATH=./certs/server.key
# SSL_CERT_PATH=./certs/server.crt
# SSL_CA_PATH=./certs/ca.crt
HTTPS_PORT=4443
# Optional HTTP listener when HTTPS is enabled
# HTTP_PORT=4000
SSL_KEY_PATH=
SSL_CERT_PATH=
SSL_CA_PATH=
FORCE_HTTPS=false


# CCC EMS auto import watcher
# Windows UNC example:
# EMS_WATCH_DIR=\\Conceptserver\ccc\EMS\EMSOUT
# If the service runs on the same server, a local path is usually more reliable:
# EMS_WATCH_DIR=C:\ccc\EMS\EMSOUT
EMS_WATCH_ENABLED=false
EMS_WATCH_DIR=\\Conceptserver\ccc\EMS\EMSOUT
EMS_ARCHIVE_DIR=\\Conceptserver\ccc\EMS\EMSOUT\_processed
EMS_ERROR_DIR=\\Conceptserver\ccc\EMS\EMSOUT\_error
EMS_WATCH_INTERVAL_MS=30000
EMS_FILE_STABLE_MS=5000
EMS_REQUIRE_ENV=true


# Task assignment and reminder emails
TASK_EMAIL_ENABLED=true
TASK_URGENT_CC=josh@conceptautobody.net
OWNER_EMAIL=josh@conceptautobody.net
BUSINESS_TIMEZONE=America/Los_Angeles
BUSINESS_START_HOUR=8
BUSINESS_END_HOUR=17
TASK_REMINDER_SCAN_MS=600000
